# syntax=docker/dockerfile:1.7
#
# PyBossa image for U-QUAIL.
#
#   - Server: bloomberg/pybossa, main branch, cloned at the exact commit PYBOSSA_REF.
#     The server code is never modified; it is not stored in this repository either.
#   - Theme : this repository (templates/, static/, translations/), copied as is into
#     pybossa/themes/default, after the JavaScript bundles are generated by webpack.
#
# Three stages:
#   1. theme-assets: Node 18, builds the theme bundles (static/js/gen/) and
#      rewrites the templates that reference them (same process as the theme's CI).
#   2. builder     : Python 3.12, clones the server and compiles the dependencies into /venv.
#   3. final image : Python 3.12 "slim", runtime libraries only.
#
# Build:  docker build --build-arg PYBOSSA_REF=<sha> -t pybossa .
# (compose.yaml passes PYBOSSA_REF from .env automatically)

ARG PYTHON_VERSION=3.12
ARG NODE_VERSION=18

########################################################################
# Stage 1: theme webpack bundles
########################################################################
FROM node:${NODE_VERSION}-bookworm AS theme-assets

# The whole theme: webpack writes into static/js/gen/ and into templates/
COPY . /theme
WORKDIR /theme/static/src

# Same recipe as the theme's .github/workflows/nodejs.yml:
#  - the @dtwebservices/task-presenter-components package is not on the npm registry,
#    it is downloaded from a public S3 bucket (version read from package.json);
#  - the babel 6 toolchain requires the "legacy" OpenSSL provider on Node 17+.
ENV NODE_OPTIONS=--openssl-legacy-provider
RUN TPV=$(node -p "require('./package.json').dependencies['@dtwebservices/task-presenter-components']") \
 && npm install --no-audit --no-fund \
      "https://s3.amazonaws.com/cf-s3uploads/pybv/${TPV}/task-presenter-components.tgz" \
 && npm run build \
 && rm -rf node_modules

########################################################################
# Stage 2: PyBossa server + compiled Python dependencies
########################################################################
FROM python:${PYTHON_VERSION}-slim-bookworm AS builder

ARG PYBOSSA_REPO=https://github.com/bloomberg/pybossa.git
ARG PYBOSSA_REF
RUN test -n "$PYBOSSA_REF" \
 || { echo "ERROR: PYBOSSA_REF missing (--build-arg PYBOSSA_REF=<commit sha>)" >&2; exit 1; }

# Development libraries needed to compile the dependencies
# (list from the Bloomberg CI + libmagic/libjpeg for python-magic and Pillow).
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      build-essential git pkg-config ca-certificates \
      libpq-dev \
      libxml2-dev libxslt1-dev libxmlsec1-dev libxmlsec1-openssl \
      libsasl2-dev libldap2-dev \
      libssl-dev libffi-dev libkrb5-dev \
      libjpeg-dev zlib1g-dev \
 && rm -rf /var/lib/apt/lists/*

# Shallow clone of the server, at the exact commit and nothing else.
# The .git directory is kept: it makes it possible to prove later that the
# installed code is identical to upstream (`make verify-upstream` target).
RUN git init -q /app \
 && cd /app \
 && git remote add origin "$PYBOSSA_REPO" \
 && git fetch -q --depth 1 origin "$PYBOSSA_REF" \
 && git checkout -q --detach FETCH_HEAD \
 && echo "$PYBOSSA_REF" > /app/PYBOSSA_REF

WORKDIR /app

# Upstream requirements.txt contains "-e .": editable install,
# the package stays in /app. gunicorn is the WSGI server added by the packaging.
RUN --mount=type=cache,target=/root/.cache/pip \
    python -m venv /venv \
 && /venv/bin/pip install --upgrade pip wheel setuptools \
 && /venv/bin/pip install -r requirements.txt gunicorn==23.0.0

########################################################################
# Stage 3: final image
########################################################################
FROM python:${PYTHON_VERSION}-slim-bookworm

# Runtime shared libraries (the "non -dev" counterparts of stage 2),
# postgresql-client for pg_isready and backups, git for verify-upstream.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates curl git postgresql-client \
      libpq5 libxml2 libxslt1.1 libxmlsec1-openssl \
      libldap-2.5-0 libsasl2-2 libkrb5-3 libgssapi-krb5-2 \
      libmagic1 libjpeg62-turbo \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --system --uid 1000 --create-home --shell /usr/sbin/nologin pybossa \
 && git config --system --add safe.directory /app

COPY --from=builder /venv /venv
COPY --from=builder /app  /app

# The theme: the one from this repository, with the bundles generated in stage 1.
# The empty upstream submodule is replaced.
RUN rm -rf /app/pybossa/themes/default
COPY --from=theme-assets /theme/templates    /app/pybossa/themes/default/templates
COPY --from=theme-assets /theme/static       /app/pybossa/themes/default/static
COPY --from=theme-assets /theme/translations /app/pybossa/themes/default/translations
COPY --from=theme-assets /theme/info.json    /app/pybossa/themes/default/info.json

COPY deploy/alembic.ini   /app/alembic.ini
COPY deploy/entrypoint.sh /usr/local/bin/pybossa-entrypoint

RUN sed -i 's/\r$//' /usr/local/bin/pybossa-entrypoint \
 && chmod +x /usr/local/bin/pybossa-entrypoint \
 # link expected by PyBossa for translations (see upstream CI)
 && ln -s themes/default/translations /app/pybossa/translations \
 # directories the application writes to: file uploads, Flask-Assets cache/compiled CSS
 && mkdir -p /app/uploads \
             /app/pybossa/themes/default/static/.webassets-cache \
             /app/pybossa/themes/default/static/css/gen \
             /app/pybossa/themes/default/static/js/gen \
 && chown -R pybossa:pybossa /app/uploads /app/pybossa/themes/default/static

ENV PATH="/venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYBOSSA_SETTINGS=/config/settings_local.py

WORKDIR /app
USER pybossa
EXPOSE 5000

ENTRYPOINT ["pybossa-entrypoint"]
# Default command = web server. worker and scheduler override it in compose.yaml.
# --forwarded-allow-ips '*': trusts the X-Forwarded-* headers from the Caddy proxy
# (port 5000 is never exposed outside the compose network).
CMD ["gunicorn", "--bind", "0.0.0.0:5000", "--workers", "2", "--threads", "2", \
     "--timeout", "120", "--forwarded-allow-ips", "*", "--access-logfile", "-", \
     "pybossa.run:app"]
