# Copier ce fichier en .env puis renseigner les valeurs.
# .env contient des secrets : il est ignoré par git et ne doit JAMAIS être commité.
#
# Deux usages :
#   - docker compose lit .env pour substituer ${VARIABLES} dans compose.yaml ;
#   - les conteneurs reçoivent ces variables, et deploy/settings_local.py les lit.

# ---------------------------------------------------------------------------
# Version du serveur : commit exact de bloomberg/pybossa (branche main, jamais master).
# Changer cette valeur = décision explicite de mise à jour (voir README-deploy.md).
# ---------------------------------------------------------------------------
PYBOSSA_REF=3efc060cdb2f5b05166b7b9477776dd8aa80a54c

# ---------------------------------------------------------------------------
# Adresse publique. En local : localhost. Sur la VM : le nom DNS (sans https://).
# ---------------------------------------------------------------------------
DOMAIN=localhost

# ---------------------------------------------------------------------------
# Base de données PostgreSQL (conteneur "db"). Mot de passe : openssl rand -hex 32
# ---------------------------------------------------------------------------
POSTGRES_USER=pybossa
POSTGRES_PASSWORD=
POSTGRES_DB=pybossa

# ---------------------------------------------------------------------------
# Secrets PyBossa. Générer chacun avec : openssl rand -hex 32
# (CRYPTOPAN_KEY doit faire exactement 32 caractères : openssl rand -hex 16)
# ---------------------------------------------------------------------------
SECRET_KEY=
ITSDANGEROUSKEY=
CRYPTOPAN_KEY=

# ---------------------------------------------------------------------------
# Identité de l'instance
# ---------------------------------------------------------------------------
BRAND=U-QUAIL
TITLE=U-QUAIL annotation
DESCRIPTION=Plateforme d'annotation par des experts (projet U-QUAIL)
COPYRIGHT=Université Grenoble Alpes - LIG
CONTACT_EMAIL=
# Adresses recevant les courriels d'erreur et les rapports admin (séparées par des virgules)
ADMINS=
# Dépôt public de cette instance (mention AGPL en pied de page) et langue par défaut (en|fr)
PROJECT_URL=https://gitlab.com/ia4health.daisy/pybossa
DEFAULT_LOCALE=en

# ---------------------------------------------------------------------------
# Courriel sortant (invitations, réinitialisation de mot de passe).
# Laisser MAIL_SERVER vide en local : un faux serveur (Mailpit, http://localhost:8025)
# est fourni par le profil compose "local". Sur la VM : le relais SMTP de l'UGA.
# ---------------------------------------------------------------------------
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=U-QUAIL <no-reply@example.org>

# ---------------------------------------------------------------------------
# Divers
# ---------------------------------------------------------------------------
TZ=Europe/Paris
# Nombre de processus gunicorn (2 suffisent pour 4 Go de RAM, cf. doc)
WEB_WORKERS=2
