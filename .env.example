# ===========================================================================
# U-QUAIL instance configuration — template for the .env file
# ===========================================================================
#
# HOW TO USE
#   1. Copy this file to .env, at the root of the repository:   cp .env.example .env
#   2. Fill in the lines marked [REQUIRED]; review the lines marked [VM].
#   3. Never commit .env: it contains secrets (git already ignores it).
#
# Each machine has ITS OWN .env: one on each workstation, one on the VM.
# When this template gains a variable, add it by hand to every existing .env.
#
# MARKERS
#   [REQUIRED]   empty here, mandatory: the instance refuses to start without it.
#   [VM]         the default suits a workstation; adapt it on the VM.
#   [DECISION]   change only on purpose (upgrade, migration…).
#   (no marker)  the default is fine everywhere.
#
# GENERATING A SECRET
#   Linux / VM:   openssl rand -hex 32
#   Windows:      python -c "import secrets; print(secrets.token_hex(32))"
#   Paste the value as is, without quotes. One secret per variable, all different.
#
# SYNTAX
#   NAME=value, no spaces around "=". A value containing spaces goes in double quotes.
#
# WHO READS THIS FILE
#   - docker compose: the ${...} variables in compose.yaml (build and startup);
#   - the containers: deploy/settings_local.py and scripts/*.sh.
#   Details: README-deploy.md, section 3 "First installation".
# ===========================================================================


# ---------------------------------------------------------------------------
# 1. PyBossa server: which version, and where to clone it from
# ---------------------------------------------------------------------------
# [DECISION] Exact server commit (bloomberg/pybossa, branch main, never master).
# Change it only through "make upgrade REF=<sha>", outside campaigns (README-deploy.md §4).
PYBOSSA_REF=3efc060cdb2f5b05166b7b9477776dd8aa80a54c

# Repository the server is cloned from when the image is built.
# U-QUAIL value: our unmodified copy on GRICAD, kept up to date monthly by the
# ia4health.daisy/pybossa/synchro project (which never force-pushes: history
# rewritten at Bloomberg erases nothing here). See README-deploy.md "Durability".
# Empty = fall back to upstream https://github.com/bloomberg/pybossa.git.
PYBOSSA_REPO=https://gricad-gitlab.univ-grenoble-alpes.fr/ia4health.daisy/pybossa/pybossa.git


# ---------------------------------------------------------------------------
# 2. Public address
# ---------------------------------------------------------------------------
# [VM] DNS name of the VM, without https:// (e.g. uquail.univ-grenoble-alpes.fr).
# Workstation: localhost (self-signed certificate; the browser warning is expected).
DOMAIN=localhost


# ---------------------------------------------------------------------------
# 3. PostgreSQL database ("db" container)
# ---------------------------------------------------------------------------
POSTGRES_USER=pybossa
# [REQUIRED] Secret (see "Generating a secret"). Fixed when the database is created:
# changing it afterwards breaks the connection (it would also have to change in PostgreSQL).
POSTGRES_PASSWORD=
POSTGRES_DB=pybossa


# ---------------------------------------------------------------------------
# 4. PyBossa secrets
# ---------------------------------------------------------------------------
# [REQUIRED] Signs session cookies. Changing it logs everyone out.
SECRET_KEY=
# [REQUIRED] Signs links sent by e-mail (password reset…).
# Changing it invalidates links already sent, nothing else.
ITSDANGEROUSKEY=
# [REQUIRED] Anonymises IP addresses. EXACTLY 32 characters:
#   openssl rand -hex 16   |   python -c "import secrets; print(secrets.token_hex(16))"
CRYPTOPAN_KEY=


# ---------------------------------------------------------------------------
# 5. Instance identity (footer, titles, e-mails)
# ---------------------------------------------------------------------------
BRAND=U-QUAIL
TITLE="U-QUAIL annotation"
DESCRIPTION="Expert annotation platform (U-QUAIL project)"
COPYRIGHT="Université Grenoble Alpes - LIG"
# [VM] Contact address shown to users.
CONTACT_EMAIL=
# [VM] Addresses receiving error e-mails and admin reports (comma-separated).
ADMINS=
# Public repository of this theme: the "source code" link in the footer, required by the AGPL.
# Change it only if the theme repository moves.
PROJECT_URL=https://gricad-gitlab.univ-grenoble-alpes.fr/ia4health.daisy/pybossa/pybossa-uquail-theme
# Default interface language: en or fr.
DEFAULT_LOCALE=en


# ---------------------------------------------------------------------------
# 6. Outgoing e-mail (account creation, password reset)
# ---------------------------------------------------------------------------
# Workstation: leave everything as is. E-mails are caught by Mailpit
#   (compose profile "local"), readable at http://localhost:8025.
# [VM] Fill in the UGA SMTP relay: without it no e-mail goes out
#   (new accounts never receive their password).
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
# [VM] Displayed sender: a real UGA address, otherwise e-mails end up in spam.
MAIL_DEFAULT_SENDER="U-QUAIL <no-reply@example.org>"


# ---------------------------------------------------------------------------
# 7. Backups (scripts/backup.sh, scheduled nightly: scripts/cron.example)
# ---------------------------------------------------------------------------
# Local backup folder, outside the git repository.
BACKUP_DIR=./backups
# Rotation: deletes local backups older than N days.
BACKUP_KEEP_DAYS=30
# [VM] PUBLIC "age" key (apt install age ; age-keygen): when set, backups are encrypted.
# The PRIVATE key stays off the VM (password manager): without it, no restore is possible.
BACKUP_AGE_RECIPIENT=
# [VM] Off-machine copy via rsync (e.g. user@stockage.univ-grenoble-alpes.fr:/sauvegardes/uquail/).
# Empty = backups only on the VM (lost along with it).
BACKUP_REMOTE=


# ---------------------------------------------------------------------------
# 8. Miscellaneous
# ---------------------------------------------------------------------------
TZ=Europe/Paris
# Number of gunicorn processes: 2 is enough for a 4 GB RAM VM.
WEB_WORKERS=2


# ---------------------------------------------------------------------------
# 9. Optional settings: remove the # to enable
# ---------------------------------------------------------------------------
# E-mail address confirmation when an account is created. Disabled by default
# until the SMTP relay is validated; set to false once e-mail works.
#ACCOUNT_CONFIRMATION_DISABLED=true
# Log verbosity: DEBUG, INFO (default), WARNING, ERROR.
#LOG_LEVEL=INFO
# PRIVATE "age" key used by scripts/restore.sh (default: ~/.config/age/key.txt).
# Set it only on the machine doing the restore, never on the VM in normal operation.
#BACKUP_AGE_IDENTITY=
