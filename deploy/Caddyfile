# Caddy reverse proxy: terminates HTTPS and forwards to the "web" service (gunicorn:5000).
#
# DOMAIN comes from .env (via compose.yaml):
#   - DOMAIN=localhost            : Caddy issues a self-signed certificate (browser
#                                   warning, expected on the workstation);
#   - DOMAIN=uquail.univ-....fr   : Caddy obtains and renews a Let's Encrypt certificate
#                                   on its own. Port 80 must be open for this.

# Plain HTTP access, reserved for the workstation (compose only publishes it on 127.0.0.1:8080).
# Used by tools that reject the self-signed certificate (automated tests, screenshots).
# Login is possible (DOMAIN=localhost lifts the HTTPS requirement); never exposed outside the machine.
http://localhost:8080 {
	# No forced X-Forwarded-Proto header: deploy/settings_local.py lifts the HTTPS requirement
	# when DOMAIN=localhost, and announcing "https" would make the forms' CSRF protection fail.
	reverse_proxy web:5000
}

{$DOMAIN} {
	encode gzip

	# Sign-up: restricted to administrators by the server itself (Bloomberg fork),
	# nothing to block here.

	reverse_proxy web:5000

	log {
		output stdout
		format console
	}
}
