# Daily backup of the U-QUAIL instance (GRICAD tutorial §11).
# To install on the VM, in the crontab of the user who runs docker compose:
#     crontab -e      then paste the line below (adapt the path)
# The BACKUP_* variables are read from /opt/uquail/.env.
#
# m  h  dom mon dow  command
0  3  *   *   *    cd /opt/uquail && ./scripts/backup.sh >> /var/log/uquail-backup.log 2>&1
