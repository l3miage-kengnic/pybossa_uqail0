# What never goes into the image build context.
# (The theme's .git is excluded: submodules are copied as plain files.)
.git
.github
.gitignore
.gitmodules
.env
.env.*
!.env.example
data/
doc/
*.docx
*.md

# local artifacts: regenerated in the image
node_modules/
static/src/node_modules/
static/.webassets-cache/
static/js/gen/
static/css/gen/
static/js/app.js
static/js/app.js.map
static/css/app.css
static/css/app.css.map
coverage/
**/.DS_Store
*.swp
*.un~
*.sublime-*
*.idea/
